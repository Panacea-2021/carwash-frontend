# Local development uses the Vite proxy (vite.config.js) to the working Render backend.
# Uncomment these only if you want to hit a local backend on port 3002:
# VITE_API_URL=http://localhost:3002/api
# VITE_API_ORIGIN=http://localhost:3002

# Production API (Render backend)
VITE_API_URL=https://carwash-backend-k3pk.onrender.com/api
VITE_API_BASE_URL=https://carwash-backend-k3pk.onrender.com/api
VITE_API_ORIGIN=https://carwash-backend-k3pk.onrender.com
